@model IEnumerable< Clinic_Appointment_System.Models.Doctor>
<link rel="stylesheet" href="~/css/site.css" />
<h2>Detail Of Doctors</h2>
<div>
    <table>
        <thead>
            <tr>
                <th>Full Name</th>
                <th>Specialization</th>
                <th>Email</th>
                <th>Phone Number</th>
                <th>Qualification</th>
                <th>Consultation Fee</th>
                <th>Gender</th>
                <th>IsAvailable</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var Doctor in Model)
            {
                <tr>
                    <td>@Doctor.FullName</td>
                    <td>@Doctor.Specialization</td>
                    <td>@Doctor.Email</td>
                    <td>@Doctor.PhoneNumber</td>
                    <td>@Doctor.Qualification</td>
                    <td>@Doctor.ConsultationFee</td>
                    <td>@Doctor.Gender</td>
                    <td>@Doctor.IsAvailable</td>
                    <td>
                        <a href="/Doctor/Edit/@Doctor.Id">Edit</a>
                        <a href="/Doctor/Delete/@Doctor.Id"onclick="return confirm('Are you sure you want to delete this doctor?');">Delete</a>
                    </td>
                </tr>            
            }
        </tbody>
    </table>
</div>

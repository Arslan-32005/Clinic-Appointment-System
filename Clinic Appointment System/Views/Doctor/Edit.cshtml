@model Clinic_Appointment_System.Models.Doctor
<h2>Edit the Doctor</h2>
<link rel="stylesheet" href="~/css/site.css" />
<div>
<form action="/Doctor/Edit/@Model.Id" method="post" id="DoctorForm">
<label for="FullName">Name</label>
<input type="text" id="FullName" name="FullName" value="@Model.FullName"/><br />
<label for="Specialization">Specialization</label>
<input type="text" id="Specialization" name="Specialization" value="@Model.Specialization"/><br />
<label for="Email">Email</label>
<input type="email" id="Email" name="Email" value="@Model.Email"/><br />
<label for="PhoneNumber">Phone Number</label>
<input type="number" id="PhoneNumber" name="PhoneNumber" value="@Model.PhoneNumber"/><br />
<label for="Qualification">Qualification</label>
<select id="Qualification" name="Qualification">
    <option value="MBBS" selected="@Model.Qualification == "MBBS"">MBBS</option>
    <option value="MD" selected="@Model.Qualification == "MD"">MD</option>
    <option value="DO" selected="@Model.Qualification == "DO"">DO</option>
    <option value="PhD" selected="@Model.Qualification == "PhD"">PhD</option>
</select><br />
<label for="ConsultationFee">Consultation Fee</label>
<input type="number" id="ConsultationFee" name="ConsultationFee" value="@Model.ConsultationFee" /><br />
<label for="Gender">Gender</label>
<select id="Gender" name="Gender">
    <option value="Male" selected="@Model.Gender == "Male"">Male</option>
    <option value="Female" selected="@Model.Gender == "Female"">Female</option>
    <option value="Other" selected="@Model.Gender == "Other"">Other</option>
</select><br />
<label for="IsAvailable">Is Available</label>
        <input type="checkbox" id="IsAvailable" name="IsAvailable" value="true" checked="@(Model?.IsAvailable==true)" />
<button type="submit">Update Doctor</button>
</form>
</div>

@model Clinic_Appointment_System.Models.Doctor
<h2>Edit the Doctor</h2>
<link rel="stylesheet" href="~/css/site.css" />
<div>
<form action="/Doctor/Edit/@Model.Id" method="post" id="DoctorForm">
<label for="FullName">Name</label>
<input type="text" id="FullName" name="FullName" value="@Model.FullName"/>
<label for="Specialization">Specialization</label>
<input type="text" id="Specialization" name="Specialization" value="@Model.Specialization"/>
<label for="ConsultationFee">Consultation Fee</label>
<input type="number" id="ConsultationFee" name="ConsultationFee" value="@Model.ConsultationFee" />
<label for="IsAvailable">Is Available</label>
        <input type="checkbox" id="IsAvailable" name="IsAvailable" checked=@(Model.IsAvailable ? "checked" : "") />
<button type="submit">Update Doctor</button>
</form>
</div>

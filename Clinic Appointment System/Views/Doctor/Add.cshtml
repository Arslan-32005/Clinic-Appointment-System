@model Clinic_Appointment_System.Models.Doctor
<h2>Add the Doctor</h2>
<link rel="stylesheet" href="~/css/site.css" />

<div>
    <form action="/Doctor/Add" method="post" id="DoctorForm">
        <label for="FullName">Name</label>
        <input type="text" id="FullName" name="FullName" /><br />
        <label for="Specialization">Specialization</label>
        <input type="text" id="Specialization" name="Specialization" /><br />
        <label for="Email">Email</label>
        <input type="email" id="Email" name="Email" /><br />
        <label for="PhoneNumber">Phone Number</label>
        <input type="number" id="PhoneNumber" name="PhoneNumber" /><br />
        <label for="Qualification">Qualification</label>
        <select id="Qualification" name="Qualification">
            <option value="MBBS">MBBS</option>
            <option value="MD">MD</option>
            <option value="DO">DO</option>
            <option value="PhD">PhD</option>
        </select><br />
        <label for="ConsultationFee">Consultation Fee</label>
        <input type="number" id="ConsultationFee" name="ConsultationFee"/><br />
        <label for="Gender">Gender</label>
        <select id="Gender" name="Gender">
            <option value="Male">Male</option>
            <option value="Female">Female</option>
            <option value="Other">Other</option>
        </select><br />
        <label for="IsAvailable">Is Available</label>
        <input type="checkbox" id="IsAvailable" name="IsAvailable" value="true" />
        <button type="submit">Add Doctor</button>
    </form>
    <script src="/js/site.js"></script>
</div>
